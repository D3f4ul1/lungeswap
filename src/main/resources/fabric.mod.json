{
	"schemaVersion": 1,
	"id": "lungeswap",
	"version": "${version}",
	"name": "LungeSwap",
	"description": "Swap to your spear or trident, land an instant attack, and swap back on a single keybind. A quick hotbar swap for spear combat and 1.21.11 PvP. Client-side, no config needed.",
	"authors": [
		"D3f4ul1"
	],
	"contact": {
		"homepage": "https://github.com/D3f4ul1/lungeswap",
		"sources": "https://github.com/D3f4ul1/lungeswap/issues"
	},
	"license": "MIT",
	"environment": "client",
	"accessWidener": "lungeswap.accesswidener",
	"entrypoints": {
		"client": [
			"com.d3f4ul1.lungeswap.LungeSwapClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
