	"authors": [
		"D3f4ul1"
	],
	"contact": {
		"homepage": "https://github.com/D3f4ul1/lungeswap",
		"sources": "https://github.com/D3f4ul1/lungeswap/issues"
	},
	"license": "MIT",
	"environment": "client",
	"icon": "assets/lungeswap/icon.png",
	"accessWidener": "lungeswap.accesswidener",
	"entrypoints": {
		"client": [
			"com.d3f4ul1.lungeswap.LungeSwapClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
